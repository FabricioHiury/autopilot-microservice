# Test environment variables

PORT=3005
API_KEY="TEST_API_KEY"

# PostgreSQL test database
DATABASE_URL="postgresql://test_user:test_password@localhost:5432/test_db?schema=test&connection_limit=10"

# Application base URLs (test)
APP_BASE_URL="https://test.example.com"
AUTOPILOT_URL="https://test.example.com"

# JWT secrets (test)
JWT_SECRET="TEST_JWT_SECRET"
JWT_RESET_SECRET="TEST_JWT_RESET_SECRET"

# Email (SMTP) settings (test)
DEFAULT_EMAIL_FROM="test@example.com"
SMTP_EMAIL="test@example.com"
SMTP_PASSWORD="TEST_SMTP_PASSWORD"
SMTP_PORT=587
SMTP_SERVER="smtp.testserver.com"

# AWS S3 (optional; test)
AWS_ACCESS_KEY_ID="TEST_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="TEST_AWS_SECRET_ACCESS_KEY"
AWS_BUCKET_NAME="TEST_BUCKET_NAME"
AWS_REGION="us-east-1"

# OLX OAuth settings (test)
OLX_AUTH_URL="https://test-auth.olx.com.br/oauth"
OLX_APP_URL="https://test-apps.olx.com.br"
OLX_SCOPE="test_scope"

# Meta/Facebook App credentials (test)
META_APP_ID="TEST_META_APP_ID"
META_APP_SECRET="TEST_META_APP_SECRET"

# Instagram API settings (test)
INSTAGRAM_APP_ID="TEST_INSTAGRAM_APP_ID"
INSTAGRAM_APP_SECRET="TEST_INSTAGRAM_APP_SECRET"
INSTAGRAM_AUTH_URL="https://api.test.instagram.com/oauth"
INSTAGRAM_GRAPH_URL="https://graph.test.instagram.com"
INSTAGRAM_WEBHOOK_TOKEN="TEST_INSTAGRAM_WEBHOOK_TOKEN"

# Facebook webhook verification (test)
FACEBOOK_WEBHOOK_TOKEN="TEST_FACEBOOK_WEBHOOK_TOKEN"
