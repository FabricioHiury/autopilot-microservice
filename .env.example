# Gateway (public URL for Meta/OLX callbacks)
PORT=3005
APP_BASE_URL=http://localhost:3005
AUTOPILOT_URL=http://host.docker.internal:3003
MICROSERVICE_TOKEN=replace-with-a-shared-secret
FRONT_URL=http://localhost:3000
ENABLE_DOCS=true
BODY_LIMIT=10mb

# Dedicated microservice database. Initialize with pnpm db:push, not migrations.
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/autopilot_micro
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=

# Evolution v2.3.7 (Compose overrides URL to http://evolution-api:8080)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-an-evolution-api-key
EVOLUTION_WEBHOOK_TOKEN=replace-with-a-separate-webhook-secret
# Optional override; Compose supplies an internal callback URL
EVOLUTION_WEBHOOK_URL=

# Meta / Instagram, configure only when connecting these channels
META_APP_ID=
META_APP_SECRET=
FACEBOOK_WEBHOOK_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_AUTH_URL=https://api.instagram.com/oauth
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v24.0
INSTAGRAM_WEBHOOK_TOKEN=
# 32 bytes, base64 encoded; required for official WhatsApp token encryption
ENCRYPTION_KEY=
FFMPEG_PATH=ffmpeg

# OLX
OLX_AUTH_URL=https://auth.olx.com.br
OLX_APP_URL=https://apps.olx.com.br
OLX_SCOPE=autoservice

# Firebase: environment credentials OR a mounted service-account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_PATH=config/firebase.json
